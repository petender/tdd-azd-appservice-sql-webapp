@page "{id:int}"
@model AppServiceSqlWebapp.Web.Pages.Shipments.DetailsModel
@{
    ViewData["Title"] = $"Shipment {Model.Shipment?.TrackingNumber}";
}

<h1>Shipment Details</h1>

@if (Model.Shipment is not null)
{
    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Tracking Number</dt>
                <dd class="col-sm-9">@Model.Shipment.TrackingNumber</dd>
                <dt class="col-sm-3">Origin</dt>
                <dd class="col-sm-9">@Model.Shipment.Origin</dd>
                <dt class="col-sm-3">Destination</dt>
                <dd class="col-sm-9">@Model.Shipment.Destination</dd>
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9"><span class="badge bg-@(Model.Shipment.Status == "Delivered" ? "success" : Model.Shipment.Status == "In Transit" ? "warning" : "secondary")">@Model.Shipment.Status</span></dd>
                <dt class="col-sm-3">Weight</dt>
                <dd class="col-sm-9">@Model.Shipment.Weight.ToString("F1") kg</dd>
                <dt class="col-sm-3">Ship Date</dt>
                <dd class="col-sm-9">@Model.Shipment.ShipDate.ToString("yyyy-MM-dd HH:mm")</dd>
                <dt class="col-sm-3">Estimated Delivery</dt>
                <dd class="col-sm-9">@Model.Shipment.EstimatedDelivery.ToString("yyyy-MM-dd HH:mm")</dd>
                <dt class="col-sm-3">Driver</dt>
                <dd class="col-sm-9">@Model.Shipment.Driver?.FullName</dd>
                <dt class="col-sm-3">Warehouse</dt>
                <dd class="col-sm-9">@Model.Shipment.Warehouse?.Name</dd>
            </dl>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-page="Edit" asp-route-id="@Model.Shipment?.Id" class="btn btn-secondary">Edit</a>
    <a asp-page="Index" class="btn btn-outline-secondary">Back to List</a>
</div>
