@page "{id:int}"
@model AppServiceSqlWebapp.Web.Pages.Shipments.EditModel
@{
    ViewData["Title"] = "Edit Shipment";
}

<h1>Edit Shipment</h1>

<div class="row">
    <div class="col-md-8">
        <form method="post">
            <input type="hidden" asp-for="Shipment.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Shipment.TrackingNumber" class="form-label"></label>
                <input asp-for="Shipment.TrackingNumber" class="form-control" />
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Shipment.Origin" class="form-label"></label>
                    <input asp-for="Shipment.Origin" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Shipment.Destination" class="form-label"></label>
                    <input asp-for="Shipment.Destination" class="form-control" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="Shipment.Status" class="form-label"></label>
                    <select asp-for="Shipment.Status" class="form-select">
                        <option>Pending</option>
                        <option>In Transit</option>
                        <option>Delivered</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Shipment.Weight" class="form-label"></label>
                    <input asp-for="Shipment.Weight" class="form-control" type="number" step="0.1" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Shipment.ShipDate" class="form-label"></label>
                    <input asp-for="Shipment.ShipDate" class="form-control" type="datetime-local" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Shipment.EstimatedDelivery" class="form-label"></label>
                    <input asp-for="Shipment.EstimatedDelivery" class="form-control" type="datetime-local" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Shipment.DriverId" class="form-label">Driver</label>
                    <select asp-for="Shipment.DriverId" asp-items="Model.Drivers" class="form-select"></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Shipment.WarehouseId" class="form-label">Warehouse</label>
                    <select asp-for="Shipment.WarehouseId" asp-items="Model.Warehouses" class="form-select"></select>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
