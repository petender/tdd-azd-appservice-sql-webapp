@page
@model AppServiceSqlWebapp.Web.Pages.Shipments.IndexModel
@{
    ViewData["Title"] = "Shipments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Shipments</h1>
    <a asp-page="Create" class="btn btn-primary">New Shipment</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Tracking #</th>
                <th>Origin</th>
                <th>Destination</th>
                <th>Status</th>
                <th>Weight (kg)</th>
                <th>Ship Date</th>
                <th>Est. Delivery</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Shipments)
            {
                <tr>
                    <td>@item.TrackingNumber</td>
                    <td>@item.Origin</td>
                    <td>@item.Destination</td>
                    <td><span class="badge bg-@(item.Status == "Delivered" ? "success" : item.Status == "In Transit" ? "warning" : "secondary")">@item.Status</span></td>
                    <td>@item.Weight.ToString("F1")</td>
                    <td>@item.ShipDate.ToString("yyyy-MM-dd")</td>
                    <td>@item.EstimatedDelivery.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View</a>
                        <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
