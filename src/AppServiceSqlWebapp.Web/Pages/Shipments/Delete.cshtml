@page "{id:int}"
@model AppServiceSqlWebapp.Web.Pages.Shipments.DeleteModel
@{
    ViewData["Title"] = "Delete Shipment";
}

<h1>Delete Shipment</h1>
<p class="text-danger">Are you sure you want to delete this shipment?</p>

@if (Model.Shipment is not null)
{
    <div class="card mb-3">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Tracking Number</dt>
                <dd class="col-sm-9">@Model.Shipment.TrackingNumber</dd>
                <dt class="col-sm-3">Origin</dt>
                <dd class="col-sm-9">@Model.Shipment.Origin</dd>
                <dt class="col-sm-3">Destination</dt>
                <dd class="col-sm-9">@Model.Shipment.Destination</dd>
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Shipment.Status</dd>
            </dl>
        </div>
    </div>
    <form method="post">
        <input type="hidden" asp-for="Shipment.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
}
