@page
@model AppServiceSqlWebapp.Web.Pages.Warehouses.IndexModel
@{
    ViewData["Title"] = "Warehouses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Warehouses</h1>
    <a asp-page="Create" class="btn btn-primary">New Warehouse</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Location</th>
                <th>Capacity</th>
                <th>Occupancy</th>
                <th>Utilization</th>
                <th>Manager</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Warehouses)
            {
                var utilization = item.Capacity > 0 ? (double)item.CurrentOccupancy / item.Capacity * 100 : 0;
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Location</td>
                    <td>@item.Capacity.ToString("N0")</td>
                    <td>@item.CurrentOccupancy.ToString("N0")</td>
                    <td>
                        <div class="progress" style="min-width: 80px;">
                            <div class="progress-bar bg-@(utilization > 90 ? "danger" : utilization > 70 ? "warning" : "success")" style="width: @utilization%">@utilization.ToString("F0")%</div>
                        </div>
                    </td>
                    <td>@item.ManagerName</td>
                    <td>
                        <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View</a>
                        <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
