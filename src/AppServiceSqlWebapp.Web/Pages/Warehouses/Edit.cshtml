@page "{id:int}"
@model AppServiceSqlWebapp.Web.Pages.Warehouses.EditModel
@{
    ViewData["Title"] = "Edit Warehouse";
}

<h1>Edit Warehouse</h1>

<div class="row">
    <div class="col-md-8">
        <form method="post">
            <input type="hidden" asp-for="Warehouse.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Warehouse.Name" class="form-label"></label>
                <input asp-for="Warehouse.Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Warehouse.Location" class="form-label"></label>
                <input asp-for="Warehouse.Location" class="form-control" />
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Warehouse.Capacity" class="form-label"></label>
                    <input asp-for="Warehouse.Capacity" class="form-control" type="number" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Warehouse.CurrentOccupancy" class="form-label"></label>
                    <input asp-for="Warehouse.CurrentOccupancy" class="form-control" type="number" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Warehouse.ManagerName" class="form-label"></label>
                <input asp-for="Warehouse.ManagerName" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
