@page "{id:int}"
@model AppServiceSqlWebapp.Web.Pages.Warehouses.DeleteModel
@{
    ViewData["Title"] = "Delete Warehouse";
}

<h1>Delete Warehouse</h1>
<p class="text-danger">Are you sure you want to delete this warehouse?</p>

@if (Model.Warehouse is not null)
{
    <div class="card mb-3">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Warehouse.Name</dd>
                <dt class="col-sm-3">Location</dt>
                <dd class="col-sm-9">@Model.Warehouse.Location</dd>
                <dt class="col-sm-3">Manager</dt>
                <dd class="col-sm-9">@Model.Warehouse.ManagerName</dd>
            </dl>
        </div>
    </div>
    <form method="post">
        <input type="hidden" asp-for="Warehouse.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
}
