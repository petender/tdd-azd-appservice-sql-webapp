@page "{id:int}"
@model AppServiceSqlWebapp.Web.Pages.Warehouses.DetailsModel
@{
    ViewData["Title"] = $"Warehouse: {Model.Warehouse?.Name}";
}

<h1>Warehouse Details</h1>

@if (Model.Warehouse is not null)
{
    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Warehouse.Name</dd>
                <dt class="col-sm-3">Location</dt>
                <dd class="col-sm-9">@Model.Warehouse.Location</dd>
                <dt class="col-sm-3">Capacity</dt>
                <dd class="col-sm-9">@Model.Warehouse.Capacity.ToString("N0") units</dd>
                <dt class="col-sm-3">Current Occupancy</dt>
                <dd class="col-sm-9">@Model.Warehouse.CurrentOccupancy.ToString("N0") units</dd>
                <dt class="col-sm-3">Manager</dt>
                <dd class="col-sm-9">@Model.Warehouse.ManagerName</dd>
            </dl>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-page="Edit" asp-route-id="@Model.Warehouse?.Id" class="btn btn-secondary">Edit</a>
    <a asp-page="Index" class="btn btn-outline-secondary">Back to List</a>
</div>
