@page
@model AppServiceSqlWebapp.Web.Pages.Drivers.IndexModel
@{
    ViewData["Title"] = "Drivers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Drivers</h1>
    <a asp-page="Create" class="btn btn-primary">New Driver</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>License #</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Vehicle</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Drivers)
            {
                <tr>
                    <td>@item.FullName</td>
                    <td>@item.LicenseNumber</td>
                    <td>@item.PhoneNumber</td>
                    <td><span class="badge bg-@(item.Status == "Available" ? "success" : item.Status == "On Route" ? "primary" : "secondary")">@item.Status</span></td>
                    <td>@item.AssignedVehicle</td>
                    <td>
                        <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View</a>
                        <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
