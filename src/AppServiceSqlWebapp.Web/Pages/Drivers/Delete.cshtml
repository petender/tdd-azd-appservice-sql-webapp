@page "{id:int}"
@model AppServiceSqlWebapp.Web.Pages.Drivers.DeleteModel
@{
    ViewData["Title"] = "Delete Driver";
}

<h1>Delete Driver</h1>
<p class="text-danger">Are you sure you want to delete this driver?</p>

@if (Model.Driver is not null)
{
    <div class="card mb-3">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Driver.FullName</dd>
                <dt class="col-sm-3">License</dt>
                <dd class="col-sm-9">@Model.Driver.LicenseNumber</dd>
                <dt class="col-sm-3">Vehicle</dt>
                <dd class="col-sm-9">@Model.Driver.AssignedVehicle</dd>
            </dl>
        </div>
    </div>
    <form method="post">
        <input type="hidden" asp-for="Driver.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
}
