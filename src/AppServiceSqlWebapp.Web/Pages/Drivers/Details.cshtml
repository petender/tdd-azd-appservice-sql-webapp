@page "{id:int}"
@model AppServiceSqlWebapp.Web.Pages.Drivers.DetailsModel
@{
    ViewData["Title"] = $"Driver: {Model.Driver?.FullName}";
}

<h1>Driver Details</h1>

@if (Model.Driver is not null)
{
    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.Driver.FullName</dd>
                <dt class="col-sm-3">License Number</dt>
                <dd class="col-sm-9">@Model.Driver.LicenseNumber</dd>
                <dt class="col-sm-3">Phone</dt>
                <dd class="col-sm-9">@Model.Driver.PhoneNumber</dd>
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9"><span class="badge bg-@(Model.Driver.Status == "Available" ? "success" : Model.Driver.Status == "On Route" ? "primary" : "secondary")">@Model.Driver.Status</span></dd>
                <dt class="col-sm-3">Assigned Vehicle</dt>
                <dd class="col-sm-9">@Model.Driver.AssignedVehicle</dd>
            </dl>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-page="Edit" asp-route-id="@Model.Driver?.Id" class="btn btn-secondary">Edit</a>
    <a asp-page="Index" class="btn btn-outline-secondary">Back to List</a>
</div>
